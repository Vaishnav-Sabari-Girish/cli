---
// The `ls <section>/` links shared by the home page and every browse index,
// so each page offers the same set. The current section is marked rather
// than dropped, keeping the links in the same place from page to page.
interface Props {
	current?: (typeof SECTIONS)[number];
}

const SECTIONS = ['categories', 'tags', 'languages', 'alternatives', 'collections'] as const;

const { current } = Astro.props;
---

<nav class="browse-links" aria-label="Browse">
	{
		SECTIONS.map((section) =>
			section === current ? (
				<span class="current" aria-current="page">ls {section}/</span>
			) : (
				<a href={`/${section}/`}>ls {section}/</a>
			),
		)
	}
</nav>
